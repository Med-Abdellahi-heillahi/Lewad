# Supabase supplies SUPABASE_URL and SUPABASE_ANON_KEY to Edge Functions.
# Configure the following with `supabase secrets set`, never in Vite variables.
# Nominatim requires a descriptive User-Agent that includes a monitored contact.
NOMINATIM_USER_AGENT="Lewad/1.0 (contact: your-operations-email@example.com)"

# Optional: use a managed or self-hosted Nominatim-compatible endpoint instead
# of the public default. The endpoint must use HTTPS.
# NOMINATIM_BASE_URL=https://your-geocoding-provider.example.com
