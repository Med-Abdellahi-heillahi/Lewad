# Supabase — public, browser-safe values only.
# Copy this file to .env.local for local development. Never put a service-role
# key, database URL, or any other secret in a VITE_ variable: everything
# prefixed with VITE_ is compiled into the public JavaScript bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional map tile template. Leave this line commented out to use the default
# public OpenStreetMap tiles. Do NOT set it to an empty value: Vite loads an
# empty variable as "", which is not nullish and therefore defeats the built-in
# fallback in src/components/map/MapLocationPicker.tsx, leaving the map blank.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
